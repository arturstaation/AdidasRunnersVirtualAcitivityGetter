# Renderizado pelo Ansible a partir do vault — NÃO editar à mão. (chmod 600)
PG_USER={{ pg_user }}
PG_PASSWORD={{ vault_pg_password }}
PG_DB={{ pg_db }}
TOKEN={{ vault_telegram_token }}
CHAT_ID={{ vault_chat_id }}
ADMIN_CHAT_ID={{ vault_admin_chat_id }}
PROXY_ENABLED={{ proxy_enabled }}
{% if agent | default('') | length > 0 %}
AGENT={{ agent }}
{% endif %}
{% if proxy_enabled | bool %}
PROXY_LINK={{ proxy_link }}
PROXY_PORT={{ proxy_port }}
PROXY_USER={{ vault_proxy_user }}
PROXY_PASSWORD={{ vault_proxy_password }}
{% endif %}
