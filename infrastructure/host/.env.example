# Adidas Runners — segredos do stack isolado. Copie para `.env` NA VM (chmod 600)
# e preencha. NÃO commitar o .env real. O CI nunca vê estes valores (ficam só na VM).
#
#   cp .env.example .env && chmod 600 .env   # depois edite

# Postgres dedicado (container adidas-db) — usado tanto p/ criar o banco quanto p/ o bot.
PG_USER=adidas
PG_PASSWORD=__GERAR__          # openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
PG_DB=adidas_runners

# Telegram
TOKEN=__BOT_TOKEN__            # BotFather
CHAT_ID=__CHAT_ID__
ADMIN_CHAT_ID=__ADMIN_CHAT_ID__

# Proxy (opcional; selenium-wire é frágil em ARM — deixe false se não precisar)
PROXY_ENABLED=false
# PROXY_USER=
# PROXY_PASSWORD=
# PROXY_LINK=
# PROXY_PORT=

# User-agent custom (opcional)
# AGENT=
