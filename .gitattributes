# Garante LF nos arquivos que rodam no Linux (VM) — evita ^M / "bad interpreter".
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.j2            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.cfg           text eol=lf
*.ini           text eol=lf
Dockerfile      text eol=lf
Dockerfile.dev  text eol=lf
.env.example    text eol=lf
